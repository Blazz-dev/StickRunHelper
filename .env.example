# Stick Helper - Environment Template
# Rename this file to .env and fill in your values

# Get your token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Optional: Set your Guild (Server) ID for faster slash command syncing during development
GUILD_ID=your_guild_id_here

# Owner ID for administrative commands (your Discord User ID)
OWNER_ID=your_discord_id_here
